# ================================================
# OMAR'S APP — Umgebungsvariablen
# cp .env.example .env && nano .env
# ================================================

# App
APP_NAME=MyApp
APP_URL=https://myapp.local
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-minimum-32-chars-please

# Database — PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://{{ database.user }}:password@localhost:{{ ports.postgres }}/{{ database.name }}
DB_NAME={{ database.name }}
DB_USER={{ database.user }}
DB_PASSWORD=change-me-strong-password

# Redis
REDIS_URL=redis://localhost:{{ ports.redis }}/0

# Auth — JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:{{ ports.frontend_dev }}"]

# Auth — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# AI — OpenAI
OPENAI_API_KEY=sk-...
DEFAULT_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_COST_LIMIT_USD_PER_DAY=10.0

# AI — Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Billing — Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# GitHub (für Mobile Build Trigger in Admin)
GITHUB_TOKEN=ghp_...
GITHUB_ORG={{ github.org }}
GITHUB_REPO={{ github.repo }}

# Expo (für EAS Build)
EXPO_TOKEN=

# Feature Flags
ENABLE_AI=true
ENABLE_RAG=true
ENABLE_AGENTS=true
ENABLE_BILLING=false
ENABLE_MULTI_TENANT=true
ENABLE_WEBSOCKETS=true
ENABLE_AI_CODE_EDITOR=true

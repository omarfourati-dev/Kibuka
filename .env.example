# ================================================
# KIBUKA — Umgebungsvariablen
# cp .env.example .env && nano .env
# ================================================

# App
APP_NAME=Kibuka
APP_URL=https://kibuka.app
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-minimum-32-chars-please

# Database — PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://kibuka:password@localhost:5432/kibuka_dev
DB_NAME=kibuka_dev
DB_USER=kibuka
DB_PASSWORD=change-me-strong-password

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]

# Auth — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# AI — OpenAI
OPENAI_API_KEY=sk-...
DEFAULT_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_COST_LIMIT_USD_PER_DAY=10.0

# AI — Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Kibuka — Book Generation
DALL_E_MODEL=dall-e-3
DALL_E_IMAGE_SIZE=1024x1024
GOOGLE_TTS_CREDENTIALS_JSON={}
AWS_S3_BUCKET=kibuka-assets
AWS_S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BOOK_GENERATION_CRON=0 6 * * *
COPPA_MINIMUM_AGE=13

# Billing — Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# GitHub (für Mobile Build Trigger in Admin)
GITHUB_TOKEN=ghp_...
GITHUB_ORG=omar
GITHUB_REPO=kibuka

# Expo (für EAS Build)
EXPO_TOKEN=

# Feature Flags
ENABLE_AI=true
ENABLE_RAG=false
ENABLE_AGENTS=false
ENABLE_BILLING=true
ENABLE_MULTI_TENANT=false
ENABLE_WEBSOCKETS=true
ENABLE_AI_CODE_EDITOR=false
ENABLE_BOOK_GENERATION=true
ENABLE_ADS=true
